{
  "name": "ingress-replay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run wasm && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "format": "prettier --write \"src/*.ts\" src/style.css \"tests/*.ts\" \"*.ts\" \"*.json\" \"scripts/*.mjs\" index.html",
    "fixtures": "cargo test -p arena-viewer hud_telemetry_and_browser_fixtures"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
